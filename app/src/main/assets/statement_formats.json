{
  "_comment": "流水文件的格式定义。加一家银行 = 加一条，不改代码。列名是配置性的：各家不同，且会随账单版本变。",
  "_verification": "✅ 列名、取值、编码均已用**真实导出账单**逐字核对（2026-10-06，支付宝 CSV 596 笔 / 微信 xlsx 86 笔）。改动前请照 docs/statement-formats-real.md 的结论；那份文档记了实测方法与四个坑。",
  "version": 3,
  "_refund_note": "refund_markers/full_refund_markers 依据微信实测状态取值「已全额退款」「已退款¥6.60」。金额列的负号**不当作退款判据**——银行流水里普通借方也写成 -38.50。",
  "formats": [
    {
      "_note": "微信账单实测是 **xlsx**（不是加密 zip+csv），xlsx 与 csv 两种输入都能走这条定义——列名一样。",
      "id": "wechat",
      "display_name": "微信支付账单",
      "header_markers": ["微信支付", "微信昵称", "交易单号"],
      "encodings": ["UTF-8", "GB18030"],
      "columns": {
        "time": ["交易时间", "交易日期", "时间"],
        "type": ["交易类型", "业务类型"],
        "counterparty": ["交易对方", "对方"],
        "description": ["商品", "商品说明", "商品名称", "备注"],
        "direction": ["收/支", "收支", "收/支类型"],
        "amount": ["金额(元)", "金额（元）", "金额"],
        "status": ["当前状态", "交易状态", "状态"],
        "ref": ["交易单号", "交易号", "流水号"],
        "merchant_ref": ["商户单号", "商家订单号"]
      },
      "direction_values": {
        "expense": ["支出", "支"],
        "income": ["收入", "收"],
        "neutral": ["/", "中性交易"]
      },
      "non_consumption_types": [
        "转账", "微信红包", "红包", "群收款", "亲属卡",
        "零钱通", "理财通", "信用卡还款", "零钱提现", "充值"
      ],
      "skip_statuses": [],
      "refund_markers": ["退款", "退货"],
      "full_refund_markers": ["全额退款"],
      "time_patterns": ["yyyy-MM-dd HH:mm:ss", "yyyy/MM/dd HH:mm:ss", "yyyy-MM-dd HH:mm"]
    },
    {
      "_note": "实测表头第 24 行（前 23 行是回单头），尾部有一个多余逗号。单号列叫「交易订单号」，不是「交易号」——写成「交易号」会精确匹配不上，整份文件都会因为缺 ref 列而解析失败。",
      "id": "alipay",
      "display_name": "支付宝账单",
      "header_markers": ["支付宝", "交易订单号", "商家订单号"],
      "encodings": ["GB18030", "UTF-8"],
      "columns": {
        "time": ["交易时间", "交易创建时间", "创建时间", "付款时间"],
        "type": ["交易分类", "交易类型", "业务类型"],
        "counterparty": ["交易对方", "对方", "商户名称"],
        "description": ["商品说明", "商品名称", "商品", "备注"],
        "direction": ["收/支", "收支"],
        "amount": ["金额", "金额(元)", "金额（元）"],
        "status": ["交易状态", "当前状态", "状态"],
        "ref": ["交易订单号", "交易号", "交易单号", "流水号"],
        "merchant_ref": ["商家订单号", "商户单号"]
      },
      "direction_values": {
        "expense": ["支出", "支"],
        "income": ["收入", "收"],
        "neutral": ["不计收支", "中性交易"]
      },
      "non_consumption_types": [
        "转账红包", "转账", "红包", "余额宝", "花呗还款", "信用卡还款",
        "信用借还", "投资理财", "提现", "充值", "亲情卡"
      ],
      "skip_statuses": ["交易关闭"],
      "refund_markers": ["退款", "退货"],
      "full_refund_markers": ["全额退款"],
      "time_patterns": ["yyyy-MM-dd HH:mm:ss", "yyyy/MM/dd HH:mm:ss", "yyyy-MM-dd HH:mm"]
    },
    {
      "id": "bank_generic",
      "display_name": "银行流水（通用）",
      "header_markers": ["交易日期", "摘要", "对方户名", "借贷标志"],
      "encodings": ["GB18030", "UTF-8"],
      "columns": {
        "time": ["交易日期", "交易日", "记账日期", "日期"],
        "type": ["交易类型", "摘要", "业务摘要", "交易摘要"],
        "counterparty": ["对方户名", "对方账户名", "交易对手", "对方名称", "商户名称"],
        "description": ["摘要", "附言", "备注", "用途"],
        "direction": ["收/支", "借贷标志", "借贷方向", "收支标志"],
        "amount": ["交易金额", "发生额", "金额"],
        "status": ["交易状态", "状态"],
        "ref": ["交易流水号", "流水号", "交易序号", "凭证号"],
        "merchant_ref": ["订单号", "商户订单号"]
      },
      "direction_values": {
        "expense": ["支出", "支", "借", "付出", "转出"],
        "income": ["收入", "收", "贷", "存入", "转入"],
        "neutral": ["不计收支", "中性交易"]
      },
      "non_consumption_types": ["转账", "还款", "理财", "基金", "定期", "结息"],
      "skip_statuses": [],
      "refund_markers": ["退款", "退货"],
      "full_refund_markers": ["全额退款"],
      "time_patterns": [
        "yyyy-MM-dd HH:mm:ss", "yyyy/MM/dd HH:mm:ss",
        "yyyyMMdd", "yyyy-MM-dd", "yyyy/MM/dd"
      ]
    }
  ]
}
